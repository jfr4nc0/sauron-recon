# Sauron Recon / Hermes environment template
# Copy this file to the active Hermes profile .env, or load the values
# in the environment that runs the Gateway and the Sauron CLI.
# Never commit the copy containing real credentials.

# -----------------------------------------------------------------------------
# Sauron Recon / Firecrawl
# -----------------------------------------------------------------------------

# Optional Firecrawl endpoint. Local shared daemon default:
# http://localhost:3002
FIRECRAWL_API_URL=

# Optional API key, only when the configured Firecrawl endpoint requires it.
FIRECRAWL_API_KEY=

# Runtime state: SQLite database and generated local reports.
# Keep this outside knowledge/ and do not commit the directory.
SAURON_RECON_DATA_DIR=./runtime

# Optional project working directory used by the Hermes distribution config.
# SAURON_RECON_HOME=.

# -----------------------------------------------------------------------------
# MercadoLibre official API (OAuth 2.0)
# -----------------------------------------------------------------------------

# Keep all four values only in the active Hermes profile .env. Never commit
# client secrets, authorization codes, access tokens, or refresh tokens.
# MERCADOLIBRE_APP_ID=
# MERCADOLIBRE_CLIENT_SECRET=
# MERCADOLIBRE_ACCESS_TOKEN=
# MERCADOLIBRE_REFRESH_TOKEN=
# MERCADOLIBRE_SITE_ID=MLA
# MERCADOLIBRE_CATEGORY_ID=
# MERCADOLIBRE_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Hermes Gateway / Telegram
# -----------------------------------------------------------------------------

# Token created by @BotFather. Keep it secret; do not paste it into chat or Git.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user IDs allowed to use the bot. Comma-separated.
# Recommended: restrict this to the operator(s) who manage Sauron.
TELEGRAM_ALLOWED_USERS=

# Bot username (without @) for mention-only response in groups.
# The bot only responds in group chats when @mentioned or when a slash
# command is used. Fill this with your bot's username.
TELEGRAM_BOT_USERNAME=

# Optional numeric Telegram chat IDs allowed for group/channel operation.
# Group IDs commonly look like -1001234567890. Comma-separated.
# Leave empty if only the user allowlist is being used.
TELEGRAM_ALLOWED_CHATS=

# Optional: chats whose ordinary group messages may be observed as context.
# Use only together with an explicit group allowlist and a deliberate privacy
# configuration in Telegram. Comma-separated chat IDs.
TELEGRAM_GROUP_ALLOWED_CHATS=

# Optional; default false. When true, ordinary unmentioned messages from the
# group allowlist are recorded as context but do not trigger the agent.
TELEGRAM_OBSERVE_UNMENTIONED_GROUP_MESSAGES=false

# Alternative global allowlist supported by Hermes. Prefer the Telegram-specific
# allowlists above; do not enable GATEWAY_ALLOW_ALL_USERS for a bot with tools.
# GATEWAY_ALLOWED_USERS=
# GATEWAY_ALLOW_ALL_USERS=false
