# Optional Firecrawl endpoint. For the local self-hosted stack: http://localhost:3002
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=

# Telegram credentials are normally owned by the Hermes gateway, not committed here.
TELEGRAM_BOT_TOKEN=

# Runtime state is intentionally outside the distribution-owned knowledge source.
SAURON_RECON_DATA_DIR=./runtime
